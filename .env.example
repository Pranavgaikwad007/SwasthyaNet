# Google Maps Platform API Key for Facilities Spatial Catchment Map
# Generate your key from Google Cloud Console with Maps JavaScript API enabled:
# https://console.cloud.google.com/google/maps-apis/credentials
VITE_GOOGLE_MAPS_API_KEY=

# Google Cloud OAuth 2.0 Client ID for Google Authentication / Login
# Generate your Web Client ID from Google Cloud Console > APIs & Services > Credentials > OAuth Client ID:
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Email Login Notification Configuration
# Target email where login security alerts are automatically delivered:
NOTIFICATION_EMAIL=admin@example.org

# (Optional) SMTP Server Settings for Real Email Dispatch:
# If using Gmail, use a 16-character Google App Password:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

